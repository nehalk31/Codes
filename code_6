#include <iostream>
using namespace std;
class Complex {
int real, imag;
public:
Complex(int r = 0, int i = 0) : real(r), imag(i) {}
void display() const {
cout << real;
if (imag >= 0) cout << "+";
cout << imag << "i";
}
Complex operator++() {
++real;
++imag;
return *this;
}
Complex operator--() {
--real;
--imag;
return *this;
}
Complex operator++(int) {
Complex temp = *this;
real++;
imag++;
return temp;
}
Complex operator--(int) {
Complex temp = *this;
real--;
imag--;
return temp;
}
Complex operator+(const Complex& other) const {
return Complex(real + other.real, imag + other.imag);
}
Complex operator-(const Complex& other) const {
return Complex(real - other.real, imag - other.imag);
}
};
int main() {
Complex a(4, 3), b(2, 1);
cout << "First complex number: ";
a.display();
cout << "\nSecond complex number: ";
b.display();
cout << "\nAfter prefix increment: ";
(++a).display();
cout << "\nAfter prefix decrement: ";
(--a).display();
cout << "\nAfter postfix increment: ";
(a++).display();
cout << "\nAfter postfix decrement: ";
(a--).display();
cout << "\nAddition: ";
(a + b).display();
cout << "\nSubtraction: ";
(a - b).display();
cout << endl;
return 0;
}
